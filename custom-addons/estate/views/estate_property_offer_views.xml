<odoo>
<!-- Layout de la tabla Offers -->
    <record id="estate_property_offer_tree" model="ir.ui.view">
        <field name="name">estate.property.offer.tree</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <tree string="Property Offers" editable="bottom" decoration-success="status != 'refused'" decoration-danger="status == 'refused'">
                <field name="price"/>
                <field name="partner_id"/>
                <button name="action_accept" type="object" string="Accept" icon="fa-check" invisible="status != False"/>
                <button name="action_cancel" type="object" string="Cancel" icon="fa-times" invisible="status != False"/>
                <field name="status" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Layout del formulario Offers -->
    <record id="estate_property_offer_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Property Offers">
                <sheet>
                    <group col='2' colspan='1'>
                        <group>
                            <field name="price"/>
                            <field name="partner_id"/>
                            <field name="validity"/>
                            <field name="date_deadline"/>
                            <field name="status"/>                            
                            <field name="property_id"/>
                            <!-- <button name="action_cancel" string="Cancel" states="draft" type="object" icon="fa-times"/> -->
                        </group>                      
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>